# Backend the app talks to (defaults to the deployed server).
VITE_API_BASE=https://api.cal.fuzz.li
# Shared key the backend expects as X-API-Key (API_KEY in the server .env).
VITE_API_KEY=
# A phone you can answer, used as the mock calendar's clinic number to start
# with; you can change it in the demo panel (the server must approve it). Leave
# it empty and trips are created with calls to the clinic turned off.
VITE_DEMO_CLINIC_PHONE=
