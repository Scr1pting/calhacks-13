# Backend the app talks to (defaults to the deployed server). From a phone,
# use your computer's LAN address, e.g. http://192.168.1.20:8000.
EXPO_PUBLIC_API_BASE=https://api.cal.fuzz.li
# Shared key the backend expects as X-API-Key (API_KEY in the server .env).
EXPO_PUBLIC_API_KEY=
# A phone you can answer, used as the clinic's number to start with; you can
# change it in the demo menu (the server must approve it). Leave it empty and
# trips are created with calls to the clinic turned off.
EXPO_PUBLIC_DEMO_CLINIC_PHONE=
