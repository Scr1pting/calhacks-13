{
  "expo": {
    "name": "rider-expo",
    "slug": "rider-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "leeway",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paramobility.rider"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.READ_CALENDAR"
      ],
      "package": "com.paramobility.rider"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      [
        "expo-calendar",
        {
          "calendarPermission": "Leeway reads your calendar to find appointments you may need a ride to."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Hold the mic to talk to Leeway about your rides."
        }
      ],
      "expo-asset",
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "89f33d37-bad2-4fea-bf8b-55c0d99e103c"
      }
    },
    "owner": "dariant"
  }
}
