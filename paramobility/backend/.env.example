# Anthropic (planner + late-notice agent run on Sonnet, transcript extraction on Haiku)
ANTHROPIC_API_KEY=

# Optional shared key the frontends send as X-API-Key. Empty disables the check.
API_KEY=

# Public HTTPS URL Cartesia uses to reach the voice webhooks.
PUBLIC_BASE_URL=https://api.cal.fuzz.li

# "fake" until the real delay model in app/model is implemented, then "real".
MODEL_BACKEND=fake

# Cartesia voice. Run `python -m app.voice.setup` once to create the agents.
CARTESIA_API_KEY=
CARTESIA_FROM_NUMBER_ID=
CARTESIA_POLICY_AGENT_ID=
CARTESIA_LATE_AGENT_ID=
VOICE_WEBHOOK_SECRET=

DATABASE_PATH=./paramobility.db
