# Anthropic (planner + late-notice agent on Sonnet; rider chat and transcript extraction on Haiku)
ANTHROPIC_API_KEY=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

# Optional shared key the frontends send as X-API-Key. Empty disables the check.
API_KEY=

# Public HTTPS URL Cartesia uses to reach the voice webhooks.
PUBLIC_BASE_URL=https://api.cal.fuzz.li

# Drive times and geocoding for the delay model (app/prediction/routing.py): Google (Routes,
# traffic-aware, plus the Geocoding API) if set, else OpenRouteService (no traffic). Planning
# needs one of them.
GOOGLE_MAPS_KEY=
ORS_API_KEY=
# 1: record Google's answers for demo replays once and serve them from DEMO_CACHE_PATH.
DEMO_CACHE=0

# Cartesia voice. Run `python -m app.voice.setup` once to create the agents.
CARTESIA_API_KEY=
CARTESIA_FROM_NUMBER_ID=
CARTESIA_POLICY_AGENT_ID=
CARTESIA_LATE_AGENT_ID=
CARTESIA_MESSAGE_AGENT_ID=
VOICE_WEBHOOK_SECRET=

DATABASE_PATH=./paramobility.db
